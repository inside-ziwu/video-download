# Copy this file to .env when WeChat Channels downloading is needed.
# Never commit the real .env file.
#
# Resolver options:
# - yuanbao-login (default): reuse persisted Yuanbao login state at
#   ~/.workbuddy/credentials/yuanbao_state.json. Login once by scanning QR
#   (python3 scripts/sph_resolver.py --login), no cookie export needed.
# - public-worker: use https://sph.litao.workers.dev for public links.
#   Falls back to yuanbao-login automatically when the worker fails.
# - cookie: manually paste your Yuanbao web cookie below.
WECHAT_RESOLVER=yuanbao-login

# Default save directory for downloaded MP4s. Supports ~ and $VARS.
# Leave empty to use ~/Downloads/video-downloads. --output-dir overrides.
VD_OUTPUT_DIR=

# Required only when WECHAT_RESOLVER=cookie.
# Get this from yuanbao.tencent.com after logging in.
SPH_COOKIE=
